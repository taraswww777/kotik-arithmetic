version: '3.8'

services:
  # PostgreSQL Database
  postgres:
    image: postgres:15-alpine
    container_name: kotik-postgres
    environment:
      POSTGRES_USER: kotik
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: kotik_arithmetic
    volumes:
      - pg_data:/var/lib/postgresql/data
      - ./backups:/backups
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U kotik"]
      interval: 10s
      timeout: 5s
      retries: 5

  # API Server (NestJS)
  api:
    build:
      context: ./apps/server
      dockerfile: Dockerfile
    container_name: kotik-api
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgresql://kotik:${POSTGRES_PASSWORD}@postgres:5432/kotik_arithmetic
    depends_on:
      postgres:
        condition: service_healthy

  # Frontend Client
  client:
    build:
      context: ./apps/client
      dockerfile: Dockerfile
    container_name: kotik-client
    ports:
      - "5173:80"
    depends_on:
      - api

volumes:
  pg_data:
    driver: local