{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "*": ["node_modules/*"],
      "shared-validation": ["../packages/shared/src/validation"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}