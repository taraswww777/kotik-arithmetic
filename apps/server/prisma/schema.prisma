datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(uuid())
  userId         String?  @unique // Внутренний ID для интеграции с внешними системами (VK, MAX, ЕСИА)
  externalId     String?  @unique // Внешний идентификатор (VK ID, MAX ID, ЕСИА ID)
  
  email          String   @unique
  password       String
  
  role           UserRole  @default(USER_ROLE_CHILD) // enum: USER_ROLE_CHILD (ребёнок), USER_ROLE_PARENT (родитель)
  organizerId    String?  // ID организатора группы (учителя/родителя), если пользователь является организатором
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gameResults GameResult[]
  groups      Group[]
  
  @@index([email])
  @@index([userId])
  @@index([externalId])
}

enum UserRole {
  USER_ROLE_CHILD
  USER_ROLE_PARENT
}

model GameResult {
  id          String   @id @default(uuid())
  userId      String
  crosswordId String
  timeSpent   Int
  mistakes    Int
  operations  String[]
  difficulty  String
  completedAt DateTime
  
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([crosswordId])
}

model Group {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   GroupMember[]

  organizer User?    // Организатор группы (учитель/родитель)
  
  @@index([organizerId])
}

model GroupMember {
  groupId    String
  userId     String
  
  group      Group    @relation(fields: [groupId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  
  role       MemberRole @default(MEMBER_ROLE_MEMBER) // enum: MEMBER_ROLE_MEMBER, MEMBER_ROLE_ORGANIZER
  
  @@id([groupId, userId])
  @@unique([groupId, userId])
}

enum MemberRole {
  MEMBER_ROLE_MEMBER
  MEMBER_ROLE_ORGANIZER
}

model Competition {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  startDate   DateTime @default(now())
  endDate     DateTime?
  
  entries     CompetitionEntry[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompetitionEntry {
  competitionId String
  userId        String
  
  competition Competition @relation(fields: [competitionId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@id([competitionId, userId])
  @@unique([competitionId, userId])
}